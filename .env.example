# Токен главного бота (от @BotFather)
BOT_TOKEN=
# ID преподавателей в формате JSON-списка
ADMIN_IDS=[123456789]
# ID супергруппы с темами (начинается с -100)
GROUP_ID=-1001234567890
POLZA_API_KEY=
STUDENT_BOT_TOKEN=
# Ключ шифрования секретов. Создаётся установщиком, без него зашифрованные данные не открыть
SETTINGS_KEY=
RETENTION_DAYS=90

# Mini App
# Публичный HTTPS-адрес (туннель или домен). Без него кнопка приложения не работает
WEBAPP_URL=
WEBAPP_HOST=127.0.0.1
# 0 — не запускать приложение
WEBAPP_PORT=8088
# Срок действия initData в секундах
WEBAPP_AUTH_MAX_AGE=3600
